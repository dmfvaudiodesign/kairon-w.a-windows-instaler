PORT=2785
BIND_HOST=127.0.0.1
BASE_URL=http://127.0.0.1:2785
NODE_ENV=production
SERVE_DASHBOARD=true
WA_ENGINE=whatsapp-web.js
DB_TYPE=sqlite
DB_DATABASE=data/openwa.sqlite
DB_MAIN_DATABASE=data/main.sqlite
MEDIA_DIR=data/media
PLUGINS_DIR=data/plugins

# Permite webhooks para o próprio computador (o KAIRON recebe as mensagens em http://localhost:8765).
# Libera só estes endereços locais; o resto da proteção contra SSRF continua ligado.
SSRF_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Não grave chaves ou senhas neste arquivo. Segredos devem ser gerados no primeiro uso
# ou fornecidos pelo ambiente da máquina onde o KAIRON WA será executado.

